+
+@fragment
+fn koan_shader_fragment(input: KoanShaderVarying) -> @location(0) vec4<f32> {
+    let s = b_koan_shaders[input.instance];
+    let p = input.position.xy;
+    if (any(p < s.clip.xy) || any(p > s.clip.xy + s.clip.zw)) {
