+// KOAN: tracks (#1859), evaluated as `Track::at` does in gpui's shader.rs.
+fn koan_bezier_curve(a: f32, b: f32, s: f32) -> f32 {
+    let u = 1.0 - s;
+    return 3.0 * u * u * s * a + 3.0 * u * s * s * b + s * s * s;
+}
+
+fn koan_bezier(x1: f32, y1: f32, x2: f32, y2: f32, t: f32) -> f32 {
+    if (t <= 0.0 || t >= 1.0) {
