+        let quad = |at: Bounds<ScaledPixels>, hue: f32| gpui::Quad {
+            bounds: at,
+            content_mask: ContentMask { bounds: at },
+            background: gpui::hsla(hue, 0.5, 0.5, 1.0).into(),
+            ..Default::default()
+        };
+        let shader = |at: Bounds<ScaledPixels>, program| gpui::PaintShader {
+            order: 0,
+            bounds: at,
+            content_mask: ContentMask { bounds: at },
