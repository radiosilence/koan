+            bounds: shader,
+            content_mask: ContentMask { bounds: shader },
+            program: &PROGRAM,
+            uniforms: Arc::new(gpui::ShaderUniforms::new()),
+            image: None,
+            group: None,
+            group_inset: Default::default(),
