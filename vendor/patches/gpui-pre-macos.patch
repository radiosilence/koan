+    /// next refresh. Whether it did.
+    fn present(&self) -> bool {
+        if self.wanted.load(std::sync::atomic::Ordering::Relaxed) {
+            return false;
+        }
+        let presenter = self.hold().clone();
+        presenter.is_some_and(|present| present())
+    }
 }
 
