+    /// `hold`'s guard is held, so no present of an older frame lands after it.
+    pub fn hold(&self) -> MutexGuard<'_, Option<Arc<dyn Fn() -> bool + Send + Sync>>> {
+        self.presenter.lock().unwrap_or_else(PoisonError::into_inner)
