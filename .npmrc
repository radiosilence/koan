# @radiosilence/theme is published to GitHub Packages, which wants a token even
# to read a public package.
@radiosilence:registry=https://npm.pkg.github.com

# The token lives in a gitignored file this one points at, not in an ${ENV}
# here: aube refuses to expand environment variables in auth settings a project
# controls. scripts/styles-deps.sh writes it from GH_TOKEN or the gh login.
npmrc-auth-file=.npmrc.auth
