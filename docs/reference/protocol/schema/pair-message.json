{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairMessage",
  "description": "What the server sends down a pairing socket: `Pending` once it is open,\nthen one outcome before it closes.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "description": "`XXXX-XXXX`, for someone to type.",
          "type": "string"
        },
        "expiresIn": {
          "description": "Seconds until the pairing lapses.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "pending"
        }
      },
      "required": [
        "type",
        "id",
        "code",
        "expiresIn"
      ]
    },
    {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "approved"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "username",
        "apiKey"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "declined"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "expired"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
